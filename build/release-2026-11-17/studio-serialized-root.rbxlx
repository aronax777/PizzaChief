			<Item class="ModuleScript" referent="RBX0cb8d232caf248ad865e702e2b2338c3">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Shared presentation rules; completion and ingredient gates are enforced by the server.
local Tutorial = {}
Tutorial.RecipeId = 'margherita'
Tutorial.Ingredients = {'tomato', 'mozzarella', 'basil', 'olive_oil'}

function Tutorial.NeedsIntroduction(profile)
	return (profile.completed or 0) == 0 and not profile.tutorialCompleted and not profile.tutorialDismissed
end

function Tutorial.NextIngredient(selected, required)
	for index, id in ipairs(Tutorial.Ingredients) do
		if (selected[id] or 0) < required[id] then return id, index end
	end
	return nil, #Tutorial.Ingredients + 1
end

return Tutorial
]]></ProtectedString>
					<string name="ScriptGuid">{0107c32f-a3da-4e17-9f21-d710f6abe582}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Tutorial</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1cca72937a67f2660b0df33800002085</UniqueId>
				</Properties>
