 return round(make('Frame',parent,{Name=name,Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundColor3=color or C.paper,BackgroundTransparency=trans or 0,BorderSizePixel=0}),20)
end
