atmosphere.Density=.22 atmosphere.Offset=.25 atmosphere.Color=Color3.fromRGB(255,223,183)
atmosphere.Decay=Color3.fromRGB(154,143,119) atmosphere.Glare=.13 atmosphere.Haze=.8 atmosphere.Parent=Lighting
