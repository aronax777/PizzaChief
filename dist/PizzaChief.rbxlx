local chef=group("03 Chef's tasting counter")
box(chef,"Counter base",15,3.4,4.2,0,1.8,-14.5,C.sage)
box(chef,"Counter brass footrail",15.5,.15,.15,0,.65,-12.15,C.gold,Enum.Material.Metal)
