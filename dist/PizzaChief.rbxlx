 box(ovens,"Chimney cap",2.9,.45,2.9,x,14.8,-17.5,C.terra)
 label(ovens,"Oven plaque",x&lt;0 and "01 / FUOCO" or "02 / FIAMMA",Vector3.new(6,.9,.18),Vector3.new(x,2.5,-11.15),C.dark,C.white)
 for n=1,5 do
