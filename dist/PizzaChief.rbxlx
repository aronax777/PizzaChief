</float><float name="Offset">0.25</float></Properties></Item><Item class="BloomEffect" referent="RBX_Scene_839"><Properties><string name="Name">PizzaChiefBloom</string><bool name="Enabled">true</bool><float name="Intensity">0.18000000715255737</float><float name="Size">24</float><float name="Threshold">1.399999976158142</float></Properties></Item><Item class="ColorCorrectionEffect" referent="RBX_Scene_840"><Properties><string name="Name">PizzaChiefColor</string><float name="Brightness">0</float><float name="Contrast">0.05000000074505806</float><bool name="Enabled">true</bool><float name="Saturation">0.05999999865889549</float><Color3 name="TintColor"><R>1</R><G>0.9686274528503418</G><B>0.9058823585510254</B></Color3></Properties></Item></Item><Item class="Players" referent="RBX_Players"><Properties><string name="Name">Players</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX_ReplicatedStorage"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX_PizzaChief"><Properties><string name="Name">PizzaChief</string></Properties><Item class="ModuleScript" referent="RBX_Recipes"><Properties><string name="Name">Recipes</string><ProtectedString name="Source">-- Pizza Chief: deliberately simplified game recipes, not food-safety guidance.
-- Colors use RGB bytes; portions are game units. Dough is supplied automatically.
local Recipes = {}

Recipes.Ingredients = {
	{id="tomato", name="Томатний соус", color={197,54,40}, category="Sauce"},
	{id="mozzarella", name="Моцарела", color={255,241,195}, category="Cheese"},
